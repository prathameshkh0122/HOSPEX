PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hospex
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
# Comma separated frontend origins. For VS Code Live Server, add its port (usually 5500).
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

# Fixed admin account (seeded automatically on server start).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
